# ===== 模型配置 =====
# demo   : 演示模式，无需网络与 API Key，用于本地跑通与自动化测试
# openai : 任意 OpenAI 兼容接口（DeepSeek / 通义千问 / Kimi / vLLM / OpenAI）
# ollama : 本地离线大模型（需先安装并运行 Ollama）
SMARTQA_PROVIDER=demo

# 在线示例：DeepSeek
SMARTQA_MODEL=deepseek-chat
SMARTQA_BASE_URL=https://api.deepseek.com/v1
SMARTQA_API_KEY=

# 离线示例：Ollama
# SMARTQA_PROVIDER=ollama
# SMARTQA_MODEL=qwen2.5:7b
# SMARTQA_BASE_URL=http://localhost:11434

# ===== 生成参数 =====
SMARTQA_TEMPERATURE=0.2
SMARTQA_TOP_K=4

# ===== 知识库 =====
SMARTQA_KNOWLEDGE_DIR=./data/knowledge

# 可选：使用向量检索（需要 API Key 调用 embedding 接口）
SMARTQA_USE_EMBEDDINGS=false
SMARTQA_EMBEDDING_MODEL=text-embedding-3-small
